{
  "extends": "./electron-builder.json",
  "compression": "normal",
  "win": {
    "target": [{ "target": "zip", "arch": ["x64"] }],
    "artifactName": "OmiComic-Portable-${version}-${arch}.${ext}"
  },
  "extraFiles": [
    { "from": ".packaged-app/LICENSE", "to": "LICENSE" },
    { "from": ".packaged-app/SOURCE_CODE.txt", "to": "SOURCE_CODE.txt" },
    { "from": "resources/portable-readme.txt", "to": "使用说明.txt" }
  ]
}
